# Copy this file to .env and adjust if needed. .env is gitignored — never commit it.
# These values are consumed by docker-compose.yml and by the pytest DB tests.
#
# POSTGRES_PORT defaults to 5433 (not 5432) so the container doesn't collide
# with a Postgres instance you might already have running locally on 5432.
# Change it back to 5432 if you don't have a local Postgres and prefer that.

POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_DB=ecommerce_analytics
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

DATABASE_URL=postgresql://ecommerce:ecommerce@localhost:5433/ecommerce_analytics
